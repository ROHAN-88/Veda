// Prisma 7 schema — Phase 1 (auth).
//
// Security:
//   - The app connects via DATABASE_URL, injected from the environment only
//     (CWE-798). Use a least-privilege role and SSL outside local dev (CIS
//     PostgreSQL). Prisma parameterizes every query (mitigates CWE-89).
//   - Session tokens are NEVER stored raw — only a SHA-256 hash (`tokenHash`).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  // Prisma 7: the connection URL is NOT set here. Migrate reads it from
  // prisma.config.ts (datasource.url); the runtime client gets it via the
  // @prisma/adapter-pg driver adapter (see prisma.service.ts).
  provider = "postgresql"
}

/// An application user. Passwords are stored only as argon2id hashes.
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  projects         Project[]
  uploads          Upload[]

  @@map("users")
}

/// An uploaded image. DBA note: the file BYTES live on disk (UPLOAD_DIR), NOT in
/// Postgres — this row is metadata only. Served publicly by its unguessable id
/// (a capability URL, like a share token) so images load in read-only share views.
model Upload {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@map("uploads")
}

/// A workspace owned by a single user. Holds the whiteboard of cards.
model Project {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  cards       Card[]
  connections Connection[]
  shareLinks  ShareLink[]

  @@index([ownerId])
  @@map("projects")
}


model Card {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  w         Float    @default(240)
  h         Float    @default(160)
  content   String   @default("")
  shape     String   @default("card")
  color     String   @default("#ffffff")
  rotation  Float    @default(0)
  fontSize  Int      @default(14)
  zIndex    Int      @default(0)
  // Soft delete (Phase 8): a deleted card sets `deletedAt` rather than removing
  // the row, so undo/restore brings it back with the SAME id, zIndex, and arrows.
  // All reads filter `deletedAt: null`. Its arrows are hidden while it's deleted
  // (see the connection list filter) and reappear on restore.
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation arrows anchored to this card (Phase 5b). The FK still cascades on a
  // real row delete (e.g. project removal); ordinary card deletes are soft.
  outgoing Connection[] @relation("ConnectionSource")
  incoming Connection[] @relation("ConnectionTarget")

  @@index([projectId, deletedAt])
  @@map("cards")
}

/// A directed relation arrow linking two cards within the same project.
/// Ownership is enforced through the project relation (per-user IDOR), mirroring
/// the Card model. Deleting either endpoint card (or the project) cascades.
model Connection {
  id           String  @id @default(uuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCardId String
  sourceCard   Card    @relation("ConnectionSource", fields: [sourceCardId], references: [id], onDelete: Cascade)
  targetCardId String
  targetCard   Card    @relation("ConnectionTarget", fields: [targetCardId], references: [id], onDelete: Cascade)
  color        String  @default("#64748b")
  // Optional label rendered at the arrow's midpoint. Plain text (no markdown).
  label        String  @default("")
  // Soft delete (Phase 8): a deleted arrow sets `deletedAt`; `create` for the same
  // ordered pair restores it (keeps the id, respects the unique index). Reads
  // filter `deletedAt: null`.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One arrow per ordered pair; A->B and B->A remain distinct.
  @@unique([sourceCardId, targetCardId])
  @@index([projectId])
  @@index([targetCardId])
  @@map("connections")
}

/// A read-only public share link for a project (Phase 9). Like a session, the
/// raw token lives only in the URL the owner shares; the DB holds sha256(token)
/// for an O(1) indexed lookup. `revokedAt` turns the link off without deleting
/// the row (mirrors Session revocation). Live model: the public read always
/// reflects the project's current cards/connections — no snapshot is stored.
model ShareLink {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([projectId])
  @@map("share_links")
}

/// A server-side session. The raw token lives only in the client cookie; the
/// DB holds sha256(rawToken) for O(1) indexed lookup on each request.
model Session {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime // sliding expiry, extended on refresh
  absoluteExpiresAt DateTime // hard cap regardless of activity
  revokedAt         DateTime? // set on logout; a revoked session is never valid
  lastUsedAt        DateTime?
  ip                String?
  userAgent         String?

  @@index([userId])
  @@map("sessions")
}
