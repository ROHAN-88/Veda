# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a populated `.env` (it is git-ignored). Secrets are injected at
# runtime via environment variables only — never baked into code or images
# (CWE-798, OWASP A05).
# ---------------------------------------------------------------------------

# --- Server (NestJS API) ---
# Runtime mode: development | production | test. Controls Secure/__Host- cookie
# flags (Secure cookies are dropped by browsers over plain http in dev).
NODE_ENV=

# Port the API listens on (defaults to 3000 if unset).
PORT=

# PostgreSQL connection string used by Prisma.
# Use a LEAST-PRIVILEGE application role, NOT the postgres superuser.
# Enforce SSL outside local dev, e.g. append ?sslmode=require (CIS PostgreSQL).
# Example (local): postgresql://<user>:<password>@127.0.0.1:5432/<db>?schema=public
DATABASE_URL=

# Secret used to sign the session/CSRF cookies. MINIMUM 32 chars.
# Generate a long random value, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Comma-separated allowlist of browser origins permitted by CORS (credentials).
# Example (local): http://localhost:5173
CORS_ORIGINS=

# --- Local PostgreSQL container (docker-compose) ---
# These configure the LOCAL dev database only. Choose non-trivial values;
# there are no default credentials.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Host port the dev DB is published on (default 5432). Override if a Postgres is
# already running locally on 5432. Keep DATABASE_URL's port in sync with this.
DB_HOST_PORT=
