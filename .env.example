NODE_ENV=

# Port the API listens on (defaults to 3000 if unset).
PORT=

# PostgreSQL connection string used by Prisma. Point this at a PostgreSQL you run
# locally (installed natively) or a managed instance — there is no bundled DB.
# Use a LEAST-PRIVILEGE application role, NOT the postgres superuser.
# Enforce SSL outside local dev, e.g. append ?sslmode=require (CIS PostgreSQL).
# Example (local): postgresql://<user>:<password>@127.0.0.1:5432/<db>?schema=public
DATABASE_URL=

# Secret used to sign the session/CSRF cookies. MINIMUM 32 chars.
# Generate a long random value, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Comma-separated allowlist of browser origins permitted by CORS (credentials).
# Example (local): http://localhost:5173
CORS_ORIGINS=
