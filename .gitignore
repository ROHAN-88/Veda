# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Prisma generated client (regenerated from schema; Prisma 7 emits TS under src/)
server/src/generated/

# Uploaded user files (bytes on disk; metadata is in Postgres) — never commit.
# Anchored with a leading slash: a bare `uploads/` matches at ANY depth and would
# also swallow the source module server/src/uploads/. UPLOAD_DIR defaults to
# <cwd>/uploads; in Docker it is /app/uploads (a mounted volume).
/uploads/
/server/uploads/

# Secrets & local env — NEVER commit populated env files (CWE-798)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.gstack/
